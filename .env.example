BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_IDS=123456789
DB_PATH=bot.db
PROMPT_FILE_THRESHOLD=1500

# Хранение базы в GitHub (необязательно, но рекомендуется, если на хостинге нет постоянного диска)
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=username/prompt-bot-data
GITHUB_BRANCH=data
DB_ENCRYPT_KEY=придумайте-длинную-случайную-фразу

# Генерации (создание промта по картинке и фото с лицом)
OPENAI_API_KEY=sk-...
# Названия моделей у OpenAI меняются — если будет ошибка «model not found», поменяйте здесь (проверка: команда /aicheck)
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
PAY_PHONE=+992 978117811
PAY_METHODS=DCnext / Alif Mobi
# REF_FRIENDS_NEEDED=3   сколько друзей нужно пригласить для бонуса
# REF_MAX_BONUSES=1      сколько раз можно получить такой бонус

